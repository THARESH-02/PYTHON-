# Performance testing
def performance_test(n):

    test_contacts = []

    for i in range(n):

        phone = str(9000000000 + i)

        test_contacts.append({
            "name": "Person " + str(i),
            "phones": [phone],
            "emails": ["person" + str(i) + "@gmail.com"]
        })

    start = time.perf_counter()

    result = merge_contacts(test_contacts)

    end = time.perf_counter()

    print("\nNumber of contacts:", n)
    print("Merged contacts:", len(result))
    print("Execution time:", round(end - start, 4), "seconds")


# Test 1000 and 100000 contacts
print("\nPERFORMANCE TEST")

performance_test(1000)
performance_test(100000)

