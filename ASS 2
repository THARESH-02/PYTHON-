
import sys
import time

calls = 0

# 1. Normal recursion
def ways_naive(n):
    global calls
    calls += 1

    if n == 0:
        return 0
    if n == 1:
        return 1

    return ways_naive(n - 1) + ways_naive(n - 2)


# 2. Recursion with memoization
memo = {0: 0, 1: 1}

def ways_memo(n):
    global calls
    calls += 1

    if n in memo:
        return memo[n]

    memo[n] = ways_memo(n - 1) + ways_memo(n - 2)
    return memo[n]


# 3. Iterative method (loop)
def ways_loop(n):
    if n == 0:
        return 0
    if n == 1:
        return 1

    a, b = 0, 1

    for i in range(2, n + 1):
        a, b = b, a + b

    return b


# Test for n = 25
calls = 0
print("Naive:", ways_naive(25), "calls =", calls)

calls = 0
memo = {0: 0, 1: 1}
print("Memo:", ways_memo(25), "calls =", calls)

print("Loop:", ways_loop(25))


# Test recursion limit
print("Recursion limit:", sys.getrecursionlimit())

try:
    memo = {0: 0, 1: 1}
    calls = 0
    print("Memo 1000:", ways_memo(1000))
except RecursionError as e:
    print("Error:", e)


# Test loop for n = 1000
start = time.time()
result = ways_loop(1000)
end = time.time()

print("Loop 1000:", result)
print("Number of digits:", len(str(result)))
print("Time taken:", end - start)

